# =============================================================================
# DingoBet — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values before running docker compose.
# Never commit .env to version control.
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB=dingobet
POSTGRES_USER=dingobet
# REQUIRED — use a strong random password, not 'password'
POSTGRES_PASSWORD=

# Full connection string used by Prisma (must match above credentials)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# REQUIRED — use a strong random password
REDIS_PASSWORD=

# Full Redis URL used by the API (must match REDIS_PASSWORD above)
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# The public URL of the frontend (used for CORS)
# Example: https://dingobet.com
FRONTEND_URL=

# -----------------------------------------------------------------------------
# Authentication — REQUIRED, must be long random strings
# -----------------------------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# -----------------------------------------------------------------------------
# The Odds API (https://the-odds-api.com)
# -----------------------------------------------------------------------------
# REQUIRED — get a key at https://the-odds-api.com
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# -----------------------------------------------------------------------------
# Bet Limits (amounts in AUD)
# -----------------------------------------------------------------------------
MIN_BET_AMOUNT=1
MAX_BET_AMOUNT=10000
MAX_PAYOUT=100000

# -----------------------------------------------------------------------------
# Frontend (Next.js — baked into the Docker image at build time)
# -----------------------------------------------------------------------------
# Public URL of the API (used by browser, must be externally reachable)
# Example: https://api.dingobet.com/api
NEXT_PUBLIC_API_URL=

# Public WebSocket URL of the API
# Example: https://api.dingobet.com
NEXT_PUBLIC_WS_URL=

NEXT_PUBLIC_APP_NAME=DingoBet
