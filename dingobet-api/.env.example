# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://dingobet:STRONG_PASSWORD@localhost:5432/dingobet
SHADOW_DATABASE_URL=postgresql://dingobet:STRONG_PASSWORD@localhost:5432/dingobet_shadow

# Redis
REDIS_URL=redis://:STRONG_PASSWORD@localhost:6379

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_SECRET
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Sentry
SENTRY_DSN=your-sentry-dsn-here

# The Odds API
ODDS_API_KEY=your-odds-api-key-here
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Bet limits (AUD)
MAX_BET_AMOUNT=10000
MIN_BET_AMOUNT=1
MAX_PAYOUT=50000
